# One run of the demo without a trained model: every model slot is an off-the-shelf model.
# Copy this file, fill in the two key file paths, and start with
#   .venv/Scripts/python.exe infra/start_windows.py --overlay <your copy>
# The values are laid over backend/.env for that run only; backend/.env is not edited.
# Which model goes where follows docs/reports/2026-10-13-mature-model-comparison.md.

# Mission Agent, work items, skill extraction
AGENT_ENABLED=true
AGENT_BASE_URL=https://api.openai.com/v1
AGENT_API_KEY_FILE=<path to the OpenAI key file>
AGENT_MODEL=gpt-6.1-sol
AGENT_API_MODE=responses
# The context budget counts UTF-8 bytes. A recovery plan the Agent reads is about 12,000
# bytes, so the default of 24000 stops the run once it has also read the dashboard.
AGENT_MAX_INPUT_TOKENS=64000
# One explanation writes about 4,000 tokens and may take a minute.
AGENT_MAX_OUTPUT_TOKENS=16000
AGENT_MODEL_TIMEOUT_SECONDS=120

# Explanation of a recovery or sourcing plan
AGENT_CASE_MODEL=gpt-6.1-sol
AGENT_CASE_API_MODE=responses

# Reading supplier documents and pasted supplier replies
AGENT_SOURCING_MODEL=gpt-6.1-sol
AGENT_SOURCING_BASE_URL=https://api.openai.com/v1
AGENT_SOURCING_API_MODE=responses
AGENT_SOURCING_API_KEY_FILE=<path to the OpenAI key file>

# The workers the launcher starts only when their switch is on
LEARNING_ENABLED=true
LEARNING_GENERATION_ENABLED=true
WORK_PROCESSOR_ENABLED=true

# Emergency options and an adopted emergency plan stay open this long (seconds). Two hours
# leaves room to read the explanation, ask the Agent and approve while recording.
RECOVERY_TTL_SECONDS=7200
