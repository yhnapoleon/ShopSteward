# Copy to a private task file, e.g. var/knowledge-precloud/private.env.
# Never use or overwrite infra/.env. Generate URL-safe random credentials.
KNOWLEDGE_SERVICE_KEY=replace-with-random-private-key
KNOWLEDGE_POSTGRES_PASSWORD=replace-with-random-url-safe-password
KNOWLEDGE_POSTGRES_DB=shopsteward_knowledge_test
KNOWLEDGE_API_PORT=8020
KNOWLEDGE_POSTGRES_PORT=55434
KNOWLEDGE_OPENSEARCH_PORT=19201
KNOWLEDGE_INDEX_PREFIX=shopsteward-knowledge-precloud
KNOWLEDGE_IMAGE=shopsteward-knowledge:precloud
# Initial tags. Replace with image@sha256 after a real pull/build; no digest invented.
KNOWLEDGE_OPENSEARCH_IMAGE=opensearchproject/opensearch:3.8.0
KNOWLEDGE_POSTGRES_IMAGE=postgres:17-bookworm
KNOWLEDGE_PYTHON_IMAGE=python:3.12-slim-trixie
KNOWLEDGE_UV_IMAGE=ghcr.io/astral-sh/uv:0.12.10
# Host-process configuration (Compose uses its private container URLs/storage volume).
KNOWLEDGE_DATABASE_URL=
KNOWLEDGE_STORAGE_ROOT=var/knowledge-precloud/storage
KNOWLEDGE_OPENSEARCH_URL=http://127.0.0.1:19201
# Actual Settings fields. Blank values are removed by the Compose entrypoint,
# leaving embedding disabled. Host-process launchers should omit blank fields.
# A complete URL/API_KEY/MODEL/DIMENSIONS configuration exposes hybrid-v1, which
# may call the configured provider. Fill only after explicit budget authorization.
# Local benchmark/verifier always request lexical-v1 and never enable spending.
KNOWLEDGE_EMBEDDING_URL=
KNOWLEDGE_EMBEDDING_API_KEY=
KNOWLEDGE_EMBEDDING_MODEL=
KNOWLEDGE_EMBEDDING_DIMENSIONS=
KNOWLEDGE_EMBEDDING_PROVIDER=http-openai-compatible
KNOWLEDGE_EMBEDDING_REVISION=
# Instructions remain distinct; a single provider/model space supplies both roles.
KNOWLEDGE_EMBEDDING_QUERY_INSTRUCTION=
KNOWLEDGE_EMBEDDING_DOCUMENT_INSTRUCTION=
KNOWLEDGE_EMBEDDING_NORMALIZE=true
KNOWLEDGE_EMBEDDING_MAX_INPUT_CHARS=12000
KNOWLEDGE_EMBEDDING_DEADLINE_MS=8000
# Optional reranker: all three fields must be deliberately configured together.
# Blank defaults remain absent in the service; no separate enable flag exists.
KNOWLEDGE_RERANK_URL=
KNOWLEDGE_RERANK_API_KEY=
KNOWLEDGE_RERANK_MODEL=
