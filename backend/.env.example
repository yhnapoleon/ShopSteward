APP_ENV=development
# First configure infra/.env, then set the same random local password here.
DATABASE_URL=postgresql+asyncpg://shopsteward:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:55432/shopsteward
# Generate a random token (at least24 characters); no default identity is enabled.
AUTH_TOKENS=[]
CORS_ORIGINS=["http://localhost:3000","http://localhost:8088"]
WORKER_CONCURRENCY=4
JOB_LEASE_SECONDS=30
JOB_HEARTBEAT_SECONDS=10
JOB_TIMEOUT_SECONDS=120
WORKER_POLL_SECONDS=1
WORKER_SHUTDOWN_SECONDS=10
SIMULATION_BASE_URL=http://127.0.0.1:8001
# Match simulation/.env SIM_SERVICE_TOKEN; do not use a user/admin credential.
SIMULATION_TOKEN=REPLACE_WITH_SIMULATOR_SERVICE_TOKEN
SOURCE_STALE_SECONDS=30
PLAN_TTL_SECONDS=900
FIXED_FORECAST_TTL_SECONDS=3600
# New WorkItem processor uses the same model settings below and its own worker.
# Enable in both API and `python -m app.worker --profile work` environments.
WORK_PROCESSOR_ENABLED=false

# Optional Agent worker; keep disabled until the model key file and backend URL are configured.
AGENT_ENABLED=false
AGENT_BASE_URL=https://api.openai.com/v1
AGENT_MODEL=gpt-4.1-mini
# Use responses for gpt-5.6-luna tool calling; legacy providers keep chat_completions.
AGENT_API_MODE=chat_completions
# Optional provider-supported effort; DeepSeek forced tool calls require none.
# AGENT_REASONING_EFFORT=none
AGENT_API_KEY_FILE=
AGENT_BACKEND_URL=http://127.0.0.1:8000
AGENT_WORKER_CONCURRENCY=1
# How an approved purchase reaches the supplier. "assisted": the owner sends the generated
# order message through their own channel and pastes the supplier's reply. A supplier known
# only from its documents always uses assisted. See docs/sourcing-and-assisted-purchase.md.
PURCHASE_CHANNEL=simulator
# Sourcing on a recovery Case. A sourced plan is explained by AGENT_CASE_MODEL with the key
# and URL above. Supplier documents and pasted replies are read by AGENT_SOURCING_MODEL, which
# may sit at another provider; unset values fall back to the Case model's.
# AGENT_CASE_MODEL=
# AGENT_CASE_API_MODE=responses
# AGENT_SOURCING_MODEL=
# AGENT_SOURCING_BASE_URL=
# AGENT_SOURCING_API_KEY_FILE=
# AGENT_SOURCING_API_MODE=chat_completions
# AGENT_SOURCING_ESCALATION_MODEL=
# AGENT_SOURCING_TEXT_BUNDLE=sourcing-r1-s1
# One explanation writes about 4000 tokens; the defaults (2048, 30 s) are too small for it.
# AGENT_MAX_OUTPUT_TOKENS=16000
# AGENT_MODEL_TIMEOUT_SECONDS=120
# Only decides whether an ordinary Case analysis waits for an explanation.
# AGENT_CASE_EXPERTS_ENABLED=false
# Optional local v6 model service; keep the token private and identical on both sides.
FORECAST_V6_ENABLED=false
FORECAST_V6_URL=http://127.0.0.1:8053
FORECAST_V6_TOKEN=
FORECAST_V6_TIMEOUT_SECONDS=8
# Windows launcher: Python with ml[runtime] installed; defaults to its own interpreter.
# ML_PYTHON=D:/path/to/venv/Scripts/python.exe
# ML_V6_BUNDLE=D:/path/to/ShopSteward/var/forecast-v6/bundle
