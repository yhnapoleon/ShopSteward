APP_ENV=development
# First configure infra/.env, then set the same random local password here.
DATABASE_URL=postgresql+asyncpg://shopsteward:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:55432/shopsteward
# Generate a random token (at least24 characters); no default identity is enabled.
AUTH_TOKENS=[]
CORS_ORIGINS=["http://localhost:3000","http://localhost:8088"]
WORKER_CONCURRENCY=4
JOB_LEASE_SECONDS=30
JOB_HEARTBEAT_SECONDS=10
JOB_TIMEOUT_SECONDS=120
WORKER_POLL_SECONDS=1
WORKER_SHUTDOWN_SECONDS=10
SIMULATION_BASE_URL=http://127.0.0.1:8001
# Match simulation/.env SIM_SERVICE_TOKEN; do not use a user/admin credential.
SIMULATION_TOKEN=REPLACE_WITH_SIMULATOR_SERVICE_TOKEN
SOURCE_STALE_SECONDS=30
PLAN_TTL_SECONDS=900
FIXED_FORECAST_TTL_SECONDS=3600
# Optional Agent worker; keep disabled until the model key file and backend URL are configured.
AGENT_ENABLED=false
AGENT_BASE_URL=https://api.openai.com/v1
AGENT_MODEL=gpt-4.1-mini
AGENT_API_KEY_FILE=
AGENT_BACKEND_URL=http://127.0.0.1:8000
AGENT_WORKER_CONCURRENCY=1
