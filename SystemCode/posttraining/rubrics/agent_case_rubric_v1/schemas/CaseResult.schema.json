{
  "$defs": {
    "CallUsage": {
      "additionalProperties": false,
      "properties": {
        "cached_input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cached Input Tokens"
        },
        "call_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Call Id",
          "type": "string"
        },
        "cost": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cost"
        },
        "currency": {
          "const": "USD",
          "default": "USD",
          "title": "Currency",
          "type": "string"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Output Tokens"
        },
        "reasoning_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reasoning Tokens"
        },
        "retry_of": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retry Of"
        },
        "role": {
          "enum": [
            "root",
            "helper",
            "expert"
          ],
          "title": "Role",
          "type": "string"
        },
        "status": {
          "enum": [
            "completed",
            "error",
            "timeout",
            "rate_limited"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "call_id",
        "role",
        "status",
        "input_tokens",
        "output_tokens",
        "reasoning_tokens",
        "cached_input_tokens",
        "cost"
      ],
      "title": "CallUsage",
      "type": "object"
    },
    "CheckResult": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Check Id",
          "type": "string"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "reason": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reason",
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "pending_review",
            "missing_trace",
            "not_applicable"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "check_id",
        "status",
        "reason"
      ],
      "title": "CheckResult",
      "type": "object"
    },
    "DimensionScore": {
      "additionalProperties": false,
      "properties": {
        "applicable": {
          "title": "Applicable",
          "type": "boolean"
        },
        "dimension_id": {
          "enum": [
            "D1",
            "D2",
            "D3",
            "D4",
            "D5",
            "D6"
          ],
          "title": "Dimension Id",
          "type": "string"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "reason": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reason",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 2,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Score"
        },
        "status": {
          "enum": [
            "scored",
            "not_applicable",
            "pending_review",
            "missing_trace"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "dimension_id",
        "score",
        "applicable",
        "status",
        "reason"
      ],
      "title": "DimensionScore",
      "type": "object"
    },
    "SemanticReview": {
      "additionalProperties": false,
      "properties": {
        "case_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Case Hash",
          "type": "string"
        },
        "case_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Case Id",
          "type": "string"
        },
        "check_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Check Id",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "reason": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reason",
          "type": "string"
        },
        "review_version": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Review Version",
          "type": "string"
        },
        "reviewed_response_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Reviewed Response Hash",
          "type": "string"
        },
        "reviewer_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reviewer Id",
          "type": "string"
        },
        "reviewer_kind": {
          "enum": [
            "agent_reviewed",
            "human_reviewed"
          ],
          "title": "Reviewer Kind",
          "type": "string"
        },
        "rubric_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Rubric Hash",
          "type": "string"
        },
        "task_contract_version": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Task Contract Version",
          "type": "string"
        },
        "trace_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Trace Hash",
          "type": "string"
        },
        "verdict": {
          "enum": [
            "pass",
            "fail"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "case_hash",
        "trace_hash",
        "rubric_hash",
        "reviewed_response_hash",
        "task_contract_version",
        "reviewer_kind",
        "reviewer_id",
        "review_version",
        "check_id",
        "verdict",
        "reason",
        "evidence_refs"
      ],
      "title": "SemanticReview",
      "type": "object"
    },
    "TraceEvent": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Code",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "code",
        "evidence_refs"
      ],
      "title": "TraceEvent",
      "type": "object"
    }
  },
  "additionalProperties": false,
